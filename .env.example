# Port the app listens on
PORT=3000

# Base domain used to build short links, e.g. https://go.yoursite.com
BASE_URL=http://localhost:3000

# SQLite file location
DB_PATH=./data/prettylink.db

# Session secret - set a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login (single-admin MVP; see README for multi-user notes)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Optional: IP geolocation provider. Leave blank to disable geolocation.
# ipapi.co free tier = 1,000 req/day, no key needed but rate-limited.
# For production volume, use a paid provider (ipinfo.io, MaxMind GeoLite2 local DB, etc.)
GEO_PROVIDER=ipapi
GEO_API_KEY=

# How long (hours) before the same visitor (IP+UA hash) counts as a new unique click again
UNIQUE_WINDOW_HOURS=24

# Comma-separated list of destination domains links are allowed to redirect to.
# Leave blank to allow any domain (not recommended - see README compliance section).
ALLOWED_TARGET_DOMAINS=
